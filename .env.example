# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=order_inventory
POSTGRES_PORT=5432

# --- API ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/order_inventory
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Web app origin used in password reset links (defaults to CORS_ORIGIN).
# APP_URL=http://localhost:5173
# No mail service yet: when true, POST /api/auth/forgot-password returns the reset link.
# Defaults to true unless NODE_ENV=production. Never enable it in production.
# AUTH_EXPOSE_RESET_LINK=true
